{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lithora",
  "version": "0.3.4",
  "identifier": "io.github.kisaragi000.lithora",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lithora",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Multilingual Word and RTF editor",
    "license": "MIT OR Apache-2.0",
    "publisher": "Kisaragi and the Lithora contributors",
    "homepage": "https://github.com/Kisaragi000/Lithora",
    "copyright": "Copyright (c) 2026 Kisaragi and the Lithora contributors",
    "longDescription": "Lithora is a free, open source word processor for Word and RTF documents in English, Russian and Armenian. It lays out and edits pages with its own engine, so nothing else needs to be installed.",
    "linux": {
      "deb": {
        "section": "editors"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Armenian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../third-party/": "third-party/",
      "dictionaries/": "dictionaries/"
    }
  }
}
