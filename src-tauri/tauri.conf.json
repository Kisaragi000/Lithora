{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lithora",
  "version": "0.5.1",
  "identifier": "io.github.kisaragi000.lithora",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lithora",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Multilingual Word and RTF editor",
    "license": "MIT OR Apache-2.0",
    "publisher": "Kisaragi and the Lithora contributors",
    "homepage": "https://github.com/Kisaragi000/Lithora",
    "copyright": "Copyright (c) 2026 Kisaragi and the Lithora contributors",
    "longDescription": "Lithora is a free, open source word processor for Word, RTF, OpenDocument, HTML, Markdown and text documents in English, Russian and Armenian. It lays out and edits pages with its own engine, so nothing else needs to be installed.",
    "linux": {
      "deb": {
        "section": "editors"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "Armenian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "headerImage": "windows/installer-header.bmp",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "resources": {
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../third-party/": "third-party/",
      "dictionaries/": "dictionaries/"
    },
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Word Document",
        "description": "Word Document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor"
      },
      {
        "ext": [
          "docm"
        ],
        "name": "Word Macro-Enabled Document",
        "description": "Word Macro-Enabled Document",
        "mimeType": "application/vnd.ms-word.document.macroEnabled.12",
        "role": "Editor"
      },
      {
        "ext": [
          "dotx"
        ],
        "name": "Word Template",
        "description": "Word Template",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.template",
        "role": "Editor"
      },
      {
        "ext": [
          "dotm"
        ],
        "name": "Word Macro-Enabled Template",
        "description": "Word Macro-Enabled Template",
        "mimeType": "application/vnd.ms-word.template.macroEnabled.12",
        "role": "Editor"
      },
      {
        "ext": [
          "doc"
        ],
        "name": "Word 97-2003 Document",
        "description": "Word 97-2003 Document",
        "mimeType": "application/msword",
        "role": "Editor"
      },
      {
        "ext": [
          "dot"
        ],
        "name": "Word 97-2003 Template",
        "description": "Word 97-2003 Template",
        "mimeType": "application/msword",
        "role": "Editor"
      },
      {
        "ext": [
          "rtf"
        ],
        "name": "Rich Text Document",
        "description": "Rich Text Document",
        "mimeType": "application/rtf",
        "role": "Editor"
      },
      {
        "ext": [
          "odt"
        ],
        "name": "OpenDocument Text",
        "description": "OpenDocument Text",
        "mimeType": "application/vnd.oasis.opendocument.text",
        "role": "Editor"
      },
      {
        "ext": [
          "ott"
        ],
        "name": "OpenDocument Text Template",
        "description": "OpenDocument Text Template",
        "mimeType": "application/vnd.oasis.opendocument.text-template",
        "role": "Editor"
      }
    ]
  }
}
